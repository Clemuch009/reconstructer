{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
            {
  "source": "/",
  "destination": "/index.html"
},
{ 
        "source": "/console",
        "destination": "/console.html"
      },
      {
  "source": "/feedback",
  "destination": "/feedback.html"
},
{
  "source": "/pricing",
  "destination": "/pricing.html"
},
{
  "source": "/terms",
  "destination": "/terms.html"
},
{
  "source": "/privacy",
  "destination": "/privacy.html"
},
      {
        "source": "/observer",
        "destination": "/observer.html"
      },
      {
        "source": "/ingest",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/resolve",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/export",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/process/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/stream",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/webhook/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/session/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/document/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/documents",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/help",
        "destination": "/docs.html"
      },
      {
        "source": "/ingest/file",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/ingest/file/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/auth/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/billing/**",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/docs",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/redoc",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      },
      {
        "source": "/openapi.json",
        "run": {
          "serviceId": "qrynt",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Permissions-Policy",
            "value": "payment=(self \"https://buy.paddle.com\" \"https://sandbox-buy.paddle.com\")"
          }
        ]
      }
    ]
  }
}
